<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 응원 팀 + 변경 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="응원 팀"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMyTeam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnChangeTeam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="변경"
                android:textColor="@color/t1_red"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 경기 카드 -->
        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="28dp">

            <TextView
                android:id="@+id/tvBadge"
                style="@style/CardText"
                android:text="불러오는 중…"
                android:textColor="@color/t1_red"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTeams"
                style="@style/CardText"
                android:layout_marginTop="8dp"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScore"
                style="@style/CardText"
                android:textSize="56sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvGameInfo"
                style="@style/CardText"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvKills"
                style="@style/CardText"
                android:layout_marginTop="12dp"
                android:textSize="20sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvGold"
                style="@style/CardText"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvObjects"
                style="@style/CardText"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTime"
                style="@style/CardText"
                android:layout_marginTop="8dp"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUpdated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="⌚ 갤럭시워치에 LCK 라이브 워치 앱을 설치하면 같은 팀이 자동으로 적용돼요. 경기 알림은 폰 알림이 워치로 전달돼요."
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
