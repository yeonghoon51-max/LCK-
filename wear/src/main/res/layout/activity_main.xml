<?xml version="1.0" encoding="utf-8"?>
<!-- 원형 화면 가장자리에 글자가 잘리지 않도록 좌우/상하 여백을 넉넉히 둔다 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/tvBadge"
            style="@style/WatchText"
            android:text="불러오는 중…"
            android:textColor="@color/t1_red"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTeams"
            style="@style/WatchText"
            android:text=""
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScore"
            style="@style/WatchText"
            android:text="0 : 0"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvGameInfo"
            style="@style/WatchText"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvKills"
            style="@style/WatchText"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvGold"
            style="@style/WatchText"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvObjects"
            style="@style/WatchText"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTime"
            style="@style/WatchText"
            android:layout_marginTop="4dp"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUpdated"
            style="@style/WatchText"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvTeamHint"
            style="@style/WatchText"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
