<?xml version="1.0" encoding="utf-8"?>
<!-- 워치 앱 화면: 응원 팀 고르기. 원형 화면에 글자가 잘리지 않도록 여백을 넉넉히 둔다 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="30dp"
        android:paddingBottom="40dp">

        <TextView
            style="@style/WatchText"
            android:text="응원할 팀"
            android:textColor="@color/t1_red"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCurrent"
            style="@style/WatchText"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/WatchText"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <!-- 팀 줄들은 MainActivity 에서 코드로 채운다 -->
        <LinearLayout
            android:id="@+id/teamList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            style="@style/WatchText"
            android:layout_marginTop="12dp"
            android:text="경기 정보는 타일에서 확인해요\n시계 화면을 왼쪽으로 넘기고\n길게 누르기 → + → LCK 라이브"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
